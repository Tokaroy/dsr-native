# Compiles the FSR 1 shaders with glslc and writes them as byte arrays into one header (run by CMakeLists.txt).
# From pull request #47 (fernanfez00). Inputs: -DGLSLC=<glslc> -DSRC_DIR=<shader folder> -DOUT=<header> -DWORK=<scratch>
file(MAKE_DIRECTORY "${WORK}")
# Each entry: source file, array name, extra glslc flag ("-" for none). The EASU and RCAS shaders are built twice:
# in half precision (the default) and with -DFSR_FULL_PRECISION (settings.txt fsr_half = 0).
set(_names fsr1.vert fsr1_easu.frag fsr1_rcas.frag fsr1_easu.frag fsr1_rcas.frag)
set(_syms kFsr1VertSpv kFsr1EasuSpv kFsr1RcasSpv kFsr1EasuFullSpv kFsr1RcasFullSpv)
set(_flags - - - -DFSR_FULL_PRECISION -DFSR_FULL_PRECISION)
set(_out "// Generated by cmake/build_fsr1_spv.cmake: do not edit.\n#pragma once\n")
list(LENGTH _names _n)
math(EXPR _last "${_n} - 1")
foreach(i RANGE ${_last})
  list(GET _names ${i} _name)
  list(GET _syms ${i} _sym)
  list(GET _flags ${i} _flag)
  if(_flag STREQUAL "-")
    set(_flag "")
  endif()
  execute_process(COMMAND "${GLSLC}" -O --target-env=vulkan1.0 ${_flag} -o "${WORK}/${_sym}.spv" "${SRC_DIR}/${_name}"
                  RESULT_VARIABLE _r ERROR_VARIABLE _e)
  if(NOT _r EQUAL 0)
    message(FATAL_ERROR "glslc failed on ${_name} ${_flag}:\n${_e}")
  endif()
  file(READ "${WORK}/${_sym}.spv" _hex HEX)
  # Half-precision builds must carry RelaxedPrecision decorations (OpDecorate <id> RelaxedPrecision: the words
  # 0x00030047, id, 0), or the mediump qualifiers did nothing.
  string(REGEX MATCHALL "47000300........00000000" _relaxed "${_hex}")
  list(LENGTH _relaxed _nrelaxed)
  message(STATUS "dsr: ${_sym}: ${_nrelaxed} RelaxedPrecision decorations")
  if(_name MATCHES "frag$" AND _flag STREQUAL "" AND _nrelaxed EQUAL 0)
    message(FATAL_ERROR "${_name}: no RelaxedPrecision decorations in the half-precision build")
  endif()
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(APPEND _out "alignas(4) static const unsigned char ${_sym}[] = {${_bytes}};\n")
endforeach()
file(WRITE "${OUT}" "${_out}")
